# Copy to .env and edit if you want to override defaults.
# Nothing here is required — `docker compose up` works with none of this set.

# Optional. Enables the AI dispatch-note feature (app/ai_briefing.py).
# Without it, incidents get a deterministic templated summary instead —
# the system is fully functional either way.
ANTHROPIC_API_KEY=

# How large a synthetic network to generate on first boot.
SEED_POLE_COUNT=3600
